# Optional. When set, synthesis is rewritten by an OpenAI-compatible chat model.
# Without it, heuristic mode still cites evidence and explains why.
OPENAI_API_KEY=

# Optional: override the API base (Azure, proxy, or another OpenAI-compatible host)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model name (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional GitHub token for repository search.
# Accepted names: GITHUB_TOKEN, GH_TOKEN, GITHUB_PAT.
# Without a token the agent still calls the public Search API and falls back to a
# labeled stub if that call is rate-limited or fails. Never commit a real token.
# GITHUB_TOKEN=

# Optional: Anthropic is documented for a later dual-provider setup. v0.2 does not call it.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Server
# PORT=3000
# NODE_ENV=production
