# Required for LLM-assisted planning & synthesis (OpenAI-compatible API)
OPENAI_API_KEY=

# Optional: override OpenAI base URL (e.g. Azure, proxy, or compatible provider)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model name (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: Anthropic (documented for future / dual-provider setups; not required for happy path)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Server
# PORT=3000
# NODE_ENV=production
