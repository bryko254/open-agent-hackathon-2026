# Optional. Without this key the agent still runs in heuristic mode:
# it fetches sources, quotes overlapping sentences, and explains confidence.
OPENAI_API_KEY=

# Optional: override OpenAI base URL (e.g. Azure, proxy, or compatible provider)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model name (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: Anthropic (documented for future / dual-provider setups; not required for happy path)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional GitHub token. Public repository search works without one.
# Set one of these if GitHub returns 403/429 (unauthenticated search is rate-limited).
# GITHUB_TOKEN=
# GH_TOKEN=
# GITHUB_PAT=

# Server
# PORT=3000
# NODE_ENV=production
